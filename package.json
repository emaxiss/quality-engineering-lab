{
  "name": "quality-engineering-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Quality Engineering portfolio: UI, API, contract, performance and accessibility test suites.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:cross-browser": "CROSS_BROWSER=1 playwright test",
    "test:contract": "playwright test --project=contract-consumer --project=contract-provider",
    "test:migration:seed": "MIGRATION=1 playwright test --project=migration-seed",
    "test:migration:verify": "MIGRATION=1 playwright test --project=migration-verify",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "browsers": "playwright install --with-deps",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests \"*.{ts,js,json}\"",
    "format:check": "prettier --check src tests \"*.{ts,js,json}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "eslint": "10.11.0",
    "eslint-plugin-playwright": "2.12.0",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
