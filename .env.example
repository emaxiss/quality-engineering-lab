BASE_URL=https://rolequeue.vercel.app

# Existing account the suites sign in with
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Separate account for the log in / log out test. Logging out ends every session
# of that account, so it must not be the account above.
E2E_LOGIN_USER_EMAIL=
E2E_LOGIN_USER_PASSWORD=

# Optional: base path of the applications API, for builds that serve it elsewhere
# APPLICATIONS_API_PATH=

# Optional, upgrade tests: where the seed phase writes its snapshot (default
# migration-snapshots), and paths the upgrade removed, comma-separated, which the
# verify phase expects to answer 404
# MIGRATION_SNAPSHOT_DIR=
# MIGRATION_REMOVED_PATHS=
